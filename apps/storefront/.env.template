# Nukopijuokite į .env.local ir užpildykite.

# Publishable API raktas iš Medusa admin (Settings -> Publishable API Keys).
# Sukuriamas automatiškai per `medusa db:migrate` (initial-data-seed).
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Medusa backend adresas
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Numatytasis regionas (šalies kodas), turi atitikti regioną Medusa admin'e
NEXT_PUBLIC_DEFAULT_REGION=lt

# Viešas storefront adresas (canonical URL, sitemap). Neprivaloma.
NEXT_PUBLIC_BASE_URL=http://localhost:8000

NODE_ENV=development
